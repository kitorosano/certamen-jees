---
import PanelLayout from "@layouts/PanelLayout.astro";
import { isAuthenticated } from "@utils/auth";
import { useTranslations } from "@utils/translations";
import { YEAR } from "astro:env/server";

if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect("/");
}

const hasError = Astro.url.searchParams.get("error") === "1";
const { t } = useTranslations()
---

<PanelLayout>
  <section class="login">
    <p class="eyebrow">{t("brand", { year: YEAR })}</p>
    <h1>{t("login.title")}</h1>
    <p class="description">{t("login.description")}</p>

    <form method="post" action="/api/login">
      <label for="password">{t("login.form.password.label")}</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
        autofocus
      />
      {hasError && <p class="error" role="alert">{t("login.form.password.error")}</p>}
      <button type="submit">{t("login.form.button")}</button>
    </form>
  </section>
</PanelLayout>

<style>
  .login {
    width: min(100%, 28rem);
    margin: auto;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #5263d8;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 5vw, 2rem);
  }

  .description {
    margin: 0 0 1.5rem;
    color: #b8c1d4;
    line-height: 1.6;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  label {
    font-weight: 700;
    font-size: 0.9rem;
  }

  input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.8rem;
    border: 1px solid #ffffff2b;
    border-radius: 0.5rem;
    background: #172033;
    color: #fff;
    font: inherit;
  }

  input:focus-visible {
    border-color: #8cbbff;
    outline: 2px solid #8cbbff55;
    outline-offset: 1px;
  }

  button {
    min-height: 2.75rem;
    margin-top: 0.5rem;
    border: 0;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    background: #5263d8;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .error {
    margin: 0;
    color: #ff9eab;
  }
</style>
