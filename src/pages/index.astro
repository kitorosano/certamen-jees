---
import { QuestionTypeLabels, PRESENTATION_CHANNEL } from "../constants";
import { QuestionTypes } from "../types";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="control">
    <section class="panel">
      <p class="eyebrow">Certamen JeeS 2026</p>
      <h1>¿Qué pregunta quieres mostrar?</h1>

      <form id="presentation-form">
        <fieldset>
          {
            Object.values(QuestionTypes).map((type) => (
              <label class="type-option">
                <input
                  type="radio"
                  name="type"
                  value={type}
                  checked={type === QuestionTypes.QUESTION}
                />
                <span>{QuestionTypeLabels[type]}</span>
              </label>
            ))
          }
        </fieldset>

        <div class="id-row">
          <input
            id="entry-id"
            name="id"
            type="text"
            inputmode="numeric"
            required
            placeholder="Ej. 1"
          />
          <button type="submit">Mostrar</button>
        </div>
        <p id="status" class="status" role="status">
          Abre la previsualización para comenzar.
        </p>
      </form>

      <div class="actions">
        <button id="open-preview" type="button" class="secondary"
          >Abrir previsualización</button
        >
        <button id="clear" type="button" class="secondary" disabled
          >Limpiar pantalla</button
        >
      </div>

      <div class="answer-actions" aria-label="Resultado de la respuesta">
        <button id="correct" type="button" class="correct" disabled
          >✓ Respuesta correcta</button
        >
        <button id="incorrect" type="button" class="incorrect" disabled
          >✕ Respuesta incorrecta</button
        >
      </div>
    </section>
    <section class="help">
      <h2>Flujo de uso</h2>
      <ol>
        <li>Abre la previsualización en otra pestaña.</li>
        <li>Escribe el ID y pulsa «Mostrar».</li>
        <li>
          Cuando recibas la respuesta, activa el resultado correspondiente.
        </li>
      </ol>
      <p>Los efectos solo se ejecutan en la pantalla de previsualización.</p>
    </section>
  </main>
</Layout>

<script>
  import { PRESENTATION_CHANNEL } from "../constants";
  import type { PresentationEvent, QuestionItem } from "../types";
  import { EventType } from "../types";

  const $FORM = document.querySelector("#presentation-form") as HTMLFormElement;
  const $INPUT = document.querySelector("#entry-id") as HTMLInputElement;
  const $STATUS = document.querySelector("#status") as HTMLParagraphElement;
  const $BTN_PREVIEW = document.querySelector(
    "#open-preview",
  ) as HTMLButtonElement;
  const $BTN_CLEAR = document.querySelector("#clear") as HTMLButtonElement;
  const $BTN_CORRECT = document.querySelector("#correct") as HTMLButtonElement;
  const $BTN_INCORRECT = document.querySelector(
    "#incorrect",
  ) as HTMLButtonElement;

  const channel = new BroadcastChannel(PRESENTATION_CHANNEL);
  let currentQuestion: QuestionItem | null = null;
  let previewWindow: Window | null = null;

  const toggleAnswerButtons = (enabled: boolean) => {
    $BTN_CORRECT.disabled = !enabled;
    $BTN_INCORRECT.disabled = !enabled;
    $BTN_CLEAR.disabled = !enabled;
  };

  $BTN_PREVIEW.addEventListener("click", () => {
    previewWindow = window.open("/preview", "_blank");
    if (!previewWindow) {
      $STATUS.textContent =
        "El navegador bloqueó la pestaña. Permite ventanas emergentes e inténtalo de nuevo.";
      return;
    }
    $STATUS.textContent = "Previsualización abierta.";
  });

  const fetchQuestion = async (type: string, id: string) => {
    try {
      const url = `/api/questions/${type}/${encodeURIComponent(id)}`;
      const response = await fetch(url);
      const data = await response.json();
      if (!response.ok)
        throw new Error(data.error ?? "No se pudo cargar la entrada.");

      return data as QuestionItem;
    } catch (error) {
      throw error instanceof Error
        ? error
        : new Error("No se pudo cargar la entrada.");
    }
  };

  $FORM.addEventListener("submit", async (event) => {
    event.preventDefault();

    const type = new FormData($FORM).get("type");
    const id = $INPUT.value.trim();
    if (!type || !id) return;

    $STATUS.textContent = "Cargando entrada...";
    toggleAnswerButtons(false);

    try {
      currentQuestion = await fetchQuestion(type.toString(), id);

      channel.postMessage({
        type: EventType.PREVIEW_SHOW,
        payload: currentQuestion,
      });
      toggleAnswerButtons(true);
      $STATUS.textContent = `Mostrando ${currentQuestion.type === "questions" ? "la pregunta" : "el contenido"}${currentQuestion.id ? ` #${currentQuestion.id}` : ""}.`;
    } catch (error: any) {
      currentQuestion = null;
      toggleAnswerButtons(false);
      $STATUS.textContent = error.message;
    }
  });

  $BTN_CORRECT.addEventListener("click", () => {
    if (!currentQuestion) return;

    channel.postMessage({
      type: EventType.EFFECT_CORRECT,
      payload: currentQuestion,
    });
  });

  $BTN_INCORRECT.addEventListener("click", () => {
    if (!currentQuestion) return;

    channel.postMessage({
      type: EventType.EFFECT_INCORRECT,
      payload: currentQuestion,
    });
  });

  $BTN_CLEAR.addEventListener("click", () => {
    currentQuestion = null;
    channel.postMessage({
      type: EventType.PREVIEW_CLEAR,
      payload: currentQuestion,
    });

    toggleAnswerButtons(false);
    $STATUS.textContent = "Pantalla limpiada.";
  });

  channel.addEventListener(
    "message",
    (event: MessageEvent<PresentationEvent>) => {
      if (event.data?.type !== EventType.PREVIEW_READY) return;
      if (!currentQuestion) return;

      channel.postMessage({
        type: EventType.PREVIEW_SHOW,
        payload: currentQuestion,
      });
    },
  );

  window.addEventListener("beforeunload", () => channel.close());
</script>

<style>
  .control {
    box-sizing: border-box;
    min-height: 100%;
    display: grid;
    grid-template-columns: minmax(20rem, 36rem) minmax(16rem, 24rem);
    gap: 4rem;
    align-items: center;
    justify-content: center;
    padding: 3rem;
    color: #172033;
  }

  .panel,
  .help {
    width: 100%;
  }
  .eyebrow {
    margin: 0 0 0.5rem;
    color: #5263d8;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 5vw, 2rem);
  }
  h2 {
    font-size: 1.1rem;
  }
  .description,
  .help p,
  li {
    color: #647087;
    line-height: 1.6;
  }
  form {
    margin-top: 2rem;
  }
  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    border: 0;
    padding: 0;
  }
  legend,
  form > label {
    display: block;
    margin-bottom: 0.6rem;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .type-option {
    cursor: pointer;
  }
  .type-option input {
    position: absolute;
    opacity: 0;
  }
  .type-option span {
    display: block;
    padding: 0.7rem 0.9rem;
    border: 1px solid #d9deea;
    border-radius: 0.6rem;
    background: #fff;
  }
  .type-option input:checked + span {
    border-color: #5263d8;
    box-shadow: 0 0 0 2px #5263d833;
    color: #3949b8;
  }
  .id-row {
    display: flex;
    gap: 0.75rem;
  }
  input[type="text"] {
    min-width: 0;
    flex: 1;
    padding: 0.8rem;
    border: 1px solid #ccd3e1;
    border-radius: 0.5rem;
    font: inherit;
  }
  button {
    border: 0;
    border-radius: 0.5rem;
    padding: 0.8rem 1rem;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }
  button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  form button {
    background: #5263d8;
  }
  .status {
    min-height: 1.5rem;
    margin: 0.75rem 0 0;
    color: #647087;
    font-size: 0.9rem;
  }
  .actions,
  .answer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .secondary {
    background: #263247;
  }
  .correct {
    background: #15945d;
  }
  .incorrect {
    background: #c9364c;
  }
  .help {
    padding: 1.5rem;
    border-radius: 1rem;
    background: #eef1ff;
  }
  @media (max-width: 760px) {
    .control {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 1.5rem;
    }
  }
</style>
