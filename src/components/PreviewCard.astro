---
import { useTranslations } from "@utils/translations";

const { t } = useTranslations();
---

<section class="preview-card" aria-labelledby="preview-title">
  <div class="preview-card-header">
    <div>
      <p class="section-label">{t("panel.preview.subtitle")}</p>
    </div>
    <span class="preview-status">
      {t("panel.preview.status.disconnected")}
    </span>
  </div>
</section>

<script>
  import { PRESENTATION_CHANNEL } from "@constants";
  import { EventType } from "@types";
  import { useTranslations } from "@utils/translations";

  const { t } = useTranslations();

  const $STATUS = document.querySelector(".preview-status") as HTMLSpanElement;
  let $IFRAME = document.querySelector(
    "#preview-frame",
  ) as HTMLIFrameElement | null;
  const channel = new BroadcastChannel(PRESENTATION_CHANNEL);

  const renderFrame = () => {
    if ($IFRAME) return;

    $IFRAME = document.createElement("iframe");
    $IFRAME.id = "preview-frame";
    $IFRAME.className = "preview-frame";
    $IFRAME.src = "/preview";
    $IFRAME.loading = "eager";
    $IFRAME.title = t("panel.preview.subtitle");
    document.querySelector(".preview-card")?.append($IFRAME);
  };

  channel.addEventListener(
    "message",
    (event: MessageEvent<{ type: EventType }>) => {
      const message = event.data;

      if (message.type === EventType.PREVIEW_READY) {
        renderFrame();
        $STATUS.textContent = t("panel.preview.status.connected");
        $STATUS.classList.toggle("is-connected", true);
        return;
      }

      if (message.type === EventType.PREVIEW_CLOSED) {
        $IFRAME?.remove();
        $IFRAME = null;
        $STATUS.textContent = t("panel.preview.status.disconnected");
        $STATUS.classList.toggle("is-connected", false);
      }
    },
  );

  window.addEventListener("beforeunload", () => channel.close(), {
    once: true,
  });
</script>

<style>
  .preview-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 0;
    padding: clamp(0.5rem, 1.5vw, 1rem);
    box-sizing: border-box;
    border: 1px solid #ffffff1c;
    border-radius: 1rem;
    background: #172033d9;
    box-shadow: 0 1rem 2.5rem #05091466;
  }
  .preview-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(0.5rem, 1.5vw, 1rem);
  }
  .preview-card-header h2 {
    margin: 0.3rem 0 0;
  }
  .section-label {
    margin: 0;
    color: #8cbbff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .preview-status {
    padding: clamp(0.25rem, 0.7vw, 0.35rem) clamp(0.4rem, 1vw, 0.6rem);
    border-radius: 999px;
    background: #ffe2d6;
    color: #8a1c00;
    font-size: clamp(0.55rem, 1vw, 0.7rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .preview-status.is-connected {
    background: #dff5e9;
    color: #137346;
  }
  :global(.preview-frame) {
    display: block;
    flex: 1;
    width: 100%;
    min-height: 0;
    height: 0;
    border: 0;
    border-radius: 0.7rem;
    background: #101827;
  }

  @media (max-width: 34rem) {
    .preview-card-header {
      gap: 0.5rem;
    }

    .section-label {
      font-size: 0.6rem;
    }

    .preview-status {
      letter-spacing: 0.02em;
    }
  }
</style>
