---
import { useTranslations } from "@utils/translations";
import { getLiveCollection } from "astro:content";
import { YEAR } from "astro:env/server";
import PresentationForm from "./PresentationForm";

const { t } = useTranslations();

const [memories, swordplays] = await Promise.all([
  getLiveCollection("memories"),
  getLiveCollection("swordplays"),
]);
if (!memories?.entries || !swordplays?.entries) {
  throw new Error(t("errors.entries"));
}
---

<section class="panel">
  <p class="eyebrow">{t("brand", { year: YEAR })}</p>
  <h1>{t("panel.title")}</h1>

  <PresentationForm
    client:load
    memories={memories.entries.map(({ data }) => data)}
    swordplays={swordplays.entries.map(({ data }) => data)}
  />
</section>

<style is:global>
  .panel {
    width: 100%;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .eyebrow {
    margin: 0 0 0.5rem;
    color: #5263d8;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 5vw, 2rem);
  }
  h2 {
    font-size: 1.1rem;
  }
  .description {
    color: #b8c1d4;
    line-height: 1.6;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    border: 0;
    padding: 0;
  }
  legend,
  form > label {
    display: block;
    margin-bottom: 0.6rem;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .type-option {
    cursor: pointer;
  }
  .type-option input {
    position: absolute;
    opacity: 0;
  }
  .type-option span {
    display: block;
    padding: 0.7rem 1rem;
    border: 1px solid #ffffff2b;
    border-radius: 0.6rem;
    background: #172033;
    font-size: 0.9rem;
  }
  .type-option input + span {
    transition: all 200ms ease;
  }
  .type-option input:checked + span {
    background-color: #27375d;
    border-color: #5263d8;
    box-shadow: 0 0 0 2px #5263d833;
    color: #dce3f1;
  }
  .id-row {
    display: flex;
    gap: 0.75rem;
  }
  .combobox {
    position: relative;
    min-width: 0;
    flex: 1;
  }
  input[type="text"] {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 0.8rem;
    border: 1px solid #ffffff2b;
    border-radius: 0.5rem;
    background: #172033;
    color: #fff;
    font: inherit;
  }
  input[type="text"]::placeholder {
    color: #8290a9;
  }
  input[type="text"]:focus-visible {
    border-color: #8cbbff;
    outline: 2px solid #8cbbff55;
    outline-offset: 1px;
  }
  .options {
    position: absolute;
    z-index: 10;
    top: calc(100% + 0.35rem);
    right: 0;
    left: 0;
    max-height: 16rem;
    overflow-y: auto;
    padding: 0.35rem;
    border: 1px solid #ffffff2b;
    border-radius: 0.6rem;
    background: #172033;
    box-shadow: 0 0.75rem 1.75rem #05091466;
  }
  .option {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: auto;
    padding: 0.65rem 0.75rem;
    border-radius: 0.4rem;
    background: transparent;
    color: #dce3f1;
    font-weight: 400;
    text-align: left;
  }
  .option:hover,
  .option:focus-visible {
    background: #27375d;
    color: #fff;
    outline: 0;
    transform: none;
  }
  button {
    min-height: 2.75rem;
    border: 0;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    transition:
      transform 200ms ease,
      filter 200ms ease,
      opacity 200ms ease;
  }
  button:not(:disabled):hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  button:not(:disabled):active {
    transform: translateY(0);
  }
  button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  form button {
    background: #5263d8;
    min-width: 7rem;
  }
  .status {
    min-height: 1.25rem;
    margin: 0;
    color: #b8c1d4;
    font-size: 0.9rem;
  }
  .presentation-actions,
  .answer-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid #ffffff1c;
  }
  .section-label {
    margin: 0;
    color: #8cbbff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .actions,
  .answer-buttons {
    display: flex;
    gap: 0.75rem;
  }
  .actions button,
  .answer-buttons button {
    flex: 1;
    white-space: nowrap;
  }
  .secondary {
    background: #263247;
  }
  .correct {
    background: #15945d;
  }
  .incorrect {
    background: #c9364c;
  }
  .answer-buttons button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
</style>
