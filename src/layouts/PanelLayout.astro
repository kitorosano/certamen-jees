---
interface Props {
  title?: string;
}

const { title = "Panel de control - Certamen JeeS 2026" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main class="control">
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    font-family: Poppins, sans-serif;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .control {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    padding: 3rem;
    color: #172033;
  }

  .control > :global(*) {
    flex: 1 1 0;
    min-width: 0;
  }
</style>
