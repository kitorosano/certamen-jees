---
import { YEAR } from "astro:env/server";

const title = `Panel de control - Certamen JeeS ${YEAR}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main class="control">
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    min-width: 320px;
    min-height: 100dvh;
    font-family: Poppins, sans-serif;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background: #101827;
    color: #fff;
    color-scheme: dark;
  }

  .control {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    min-height: 100dvh;
    box-sizing: border-box;
    padding: clamp(1rem, 5vw, 3rem);
    background:
      radial-gradient(circle at 12% 10%, #27375d 0, transparent 28rem),
      radial-gradient(circle at 90% 90%, #34214d 0, transparent 25rem);
  }

  .control > :global(*) {
    flex: 1 1 0;
    min-width: 0;
  }
</style>
