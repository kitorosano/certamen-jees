---
import { useTranslations } from "@utils/translations";
import { YEAR } from "astro:env/server";

const { t } = useTranslations();
const title = `Previsualización - Certamen JeeS ${YEAR}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <p class="eyebrow">{t("brand", { year: YEAR })}</p>
    <main class="preview">
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    font-family: Poppins, sans-serif;
    width: 100%;
    min-height: 100dvh;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background: #101827;
    color: #fff;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #5263d8;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    padding-top: 1rem;
  }

  .preview {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
</style>
